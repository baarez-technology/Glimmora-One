# Shared between backend/.env and apps/web/.env.local — copy values into each.

# Backend
DATABASE_URL=sqlite+aiosqlite:///./dev.db
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_HOURS=24
BOOTSTRAP_SUPERADMIN_USERNAME=superadmin
BOOTSTRAP_SUPERADMIN_PASSWORD=ChangeMe!2026
BOOTSTRAP_SUPERADMIN_EMAIL=admin@glimmora.ai
ALLOWED_ORIGINS=http://localhost:3000

# AI (optional — endpoints return 503 if absent)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Frontend (apps/web/.env.local)
BACKEND_URL=http://localhost:8000
# JWT_SECRET — same value as backend
