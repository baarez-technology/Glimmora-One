{
  "name": "glimmora-one",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "concurrently -n web,api -c blue,magenta -k \"pnpm dev:web\" \"pnpm dev:api\"",
    "dev:web": "turbo run dev --filter=@glimmora/web",
    "dev:api": "node scripts/dev-api.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "concurrently": "^9.1.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
